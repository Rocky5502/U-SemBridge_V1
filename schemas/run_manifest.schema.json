{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "U-SemBridge Run Manifest",
  "type": "object",
  "required": ["run_id", "created_at_utc", "dataset", "model", "prompt_sha256", "decoding", "solver", "seed"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string"},
    "git_commit": {"type": ["string", "null"]},
    "dataset": {"type": "object"},
    "model": {"type": "object"},
    "prompt_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "decoding": {"type": "object"},
    "solver": {"type": "object"},
    "seed": {"type": "integer"}
  },
  "additionalProperties": true
}
